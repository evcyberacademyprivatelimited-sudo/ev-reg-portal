# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (Public Key safe for browser use)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: The portal includes a built-in instant offline/demo storage engine.
# If these environment variables are omitted or blank, the portal runs seamlessly
# in local demo mode with sample courses, videos, and leads populated.
